# Copy to .env and fill in. .env is gitignored.

# --- Postgres ------------------------------------------------------------
# Admin role used by the import + benchmark runners. Pick something other
# than the default before exposing the port off-host.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=overturemaps
# Host port the db container publishes to. pg_tileserv reaches the db over
# this port (it uses network_mode: host, not the compose network).
POSTGRES_PORT=5434

# --- pg_tileserv ---------------------------------------------------------
# Password for the read-only `tileserv` role created by
# pg-tileserv/init-role.sql. Apply with:
#   set -a; . .env; set +a
#   docker exec -i overturemaps-pg-db-1 psql -U postgres -d overturemaps \
#     -v TILESERV_PASSWORD="$TILESERV_PASSWORD" < pg-tileserv/init-role.sql
TILESERV_PASSWORD=change-me

# --- www-kepler ----------------------------------------------------------
# Public Mapbox token (pk.*). Inlined into the kepler bundle at build time,
# so use a URL-restricted token from the Mapbox dashboard. Optional — basemap
# rendering uses maplibre regardless; only Kepler features that call the
# Mapbox SDK directly need this.
MAPBOX_ACCESS_TOKEN=
